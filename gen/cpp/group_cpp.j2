std::ostream &{{ class_name }}::streamContents(std::ostream &os, const int indentLevel, bool &isOneLineOnly) const
{
{% if all_optional %}
    bool firstItem = true;
    isOneLineOnly = true;
{% for child in children %}
    if (myHas{{ child.cc }})
    {
        if (!firstItem)
            os << std::endl;
        my{{ child.cc }}->toStream(os, indentLevel);
        firstItem = false;
    }
{% endfor %}
{% else %}
    bool isFirst = true;
{% for child in children %}
{% if child.max_occurs != 1 %}
    for (auto x : my{{ child.cc }}Set)
    {
        if (!isFirst)
            os << std::endl;
        x->toStream(os, indentLevel);
        isFirst = false;
    }
{% elif child.min_occurs == 0 %}
    if (myHas{{ child.cc }})
    {
        if (!isFirst)
            os << std::endl;
        my{{ child.cc }}->toStream(os, indentLevel);
        isFirst = false;
    }
{% else %}
    if (!isFirst)
        os << std::endl;
    my{{ child.cc }}->toStream(os, indentLevel);
    isFirst = false;
{% endif %}
{% endfor %}
{% endif %}
    isOneLineOnly = !hasContents();
    return os;
}

